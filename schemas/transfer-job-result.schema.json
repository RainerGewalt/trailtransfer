{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RainerGewalt/trailtransfer/schemas/transfer-job-result.schema.json",
  "title": "TrailTransfer sealed job result",
  "description": "The record TrailTransfer publishes to trailtransfer/{worker_id}/jobs/{job_id}/result and appends to its evidence journal: a Trail Evidence Record v1 whose payload is the job result. Completed, failed, cancelled and rejected jobs with a valid job_id are sealed; a result that cannot be sealed is not published. docs/EVIDENCE_MODEL.md lists the cases without a record.",
  "allOf": [
    { "$ref": "trail-evidence-record.schema.json" },
    {
      "type": "object",
      "required": ["job_id"],
      "properties": {
        "event_type": { "type": "string", "enum": ["transfer.job.result", "transfer.job.rejected"] },
        "producer": { "type": "object", "properties": { "kind": { "const": "transfer-worker" } } },
        "policy": { "type": "object", "properties": { "kind": { "const": "transfer-policy" } } },
        "job_id": { "type": "string", "minLength": 1 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_type", "job_id", "worker_id", "status", "files_total", "files_transferred", "bytes_transferred", "errors", "policy_version", "worker_version"],
          "properties": {
            "event_type": { "const": "result" },
            "job_id": { "type": "string" },
            "worker_id": { "type": "string" },
            "action": { "type": "string", "enum": ["copy", "move", "sync", "check"] },
            "source": { "type": "string" },
            "target": { "type": "string" },
            "status": { "type": "string", "enum": ["completed", "failed", "cancelled", "rejected"] },
            "reason": { "type": "string", "description": "Machine reason for rejected/failed, e.g. policy_violation." },
            "detail": { "type": "string" },
            "justification": { "type": "string", "description": "Human 'why', from command.reason." },
            "started_at": { "type": "string", "format": "date-time" },
            "finished_at": { "type": "string", "format": "date-time" },
            "duration_ms": { "type": "integer", "minimum": 0 },
            "dry_run": { "type": "boolean", "description": "Present on every job that ran (absent on rejections): true when rclone ran with --dry-run. A dry run transfers nothing: files_transferred and bytes_transferred are 0, and files_total counts the files rclone would have transferred. Added in 0.1.2; records written by 0.1.1 and earlier do not carry it." },
            "max_file_size_mb": { "type": "integer", "minimum": 1, "description": "The policy's max_file_size_mb when rclone ran with it: files larger than this many MiB were excluded by rclone and are not counted. Added in 0.1.2." },
            "files_total": { "type": "integer", "minimum": 0 },
            "files_transferred": { "type": "integer", "minimum": 0 },
            "bytes_transferred": { "type": "integer", "minimum": 0 },
            "errors": { "type": "array", "items": { "type": "string" } },
            "rclone_exit_code": { "type": "integer" },
            "policy_version": { "type": "string" },
            "policy_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "worker_version": { "type": "string" },
            "command_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "SHA-256 of JCS(command as received)." }
          }
        }
      },
      "if": { "properties": { "event_type": { "const": "transfer.job.rejected" } } },
      "then": { "properties": { "payload": { "properties": { "status": { "const": "rejected" }, "reason": { "type": "string", "enum": ["schema_violation", "policy_violation", "duplicate_job_id", "too_many_jobs"] } }, "required": ["reason"] } } },
      "else": { "properties": { "payload": { "properties": { "status": { "enum": ["completed", "failed", "cancelled"] } } } } }
    }
  ]
}
